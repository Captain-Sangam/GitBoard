# Web server
DATABASE_URL=postgresql://user:password@localhost:5432/gitboard
AI_API_KEY=              # Anthropic API key (optional, enables AI summaries)

# Data jobs (set these when running jobs/ scripts)
GITHUB_TOKEN=            # GitHub personal access token with org read access
GITHUB_ORG=              # GitHub organization name

# AWS Lambda jobs (only needed for Serverless / Lambda deployment)
# SECRET_NAME=gitboard-job
# AWS_REGION=us-west-2
