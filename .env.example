# Web server: Next.js loads .env automatically.
# The current PostgreSQL client requires a TLS-enabled server.
DATABASE_URL=postgresql://user:password@localhost:5432/gitboard
AI_API_KEY=              # Optional Anthropic key; leave empty to disable AI calls.

# Ingestion jobs always read DATABASE_URL, GITHUB_TOKEN and GITHUB_ORG
# from an AWS Secrets Manager JSON secret, including during local execution.
# Shell variables and this .env file do not supply those three job values.
# Configure AWS credentials separately, then set these in the job environment:
# SECRET_NAME=gitboard-job
# AWS_REGION=us-west-2
# See docs/getting-started.md for the secret keys and database setup.
